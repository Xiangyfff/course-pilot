# 复制为 .env 后按需修改；.env 不提交。
# 本机 `./mvnw spring-boot:run` 会自动读这个文件（application.yml 里 spring.config.import），
# Docker 里由 compose 读取同名文件做变量替换，两种跑法共用一份配置。
# 注意：这里不要写行尾注释，properties 解析会把注释当成值的一部分。

# ---------- 应用 ----------
APP_PORT=18080
# dev = H2 内存库（重启即清空，演示用） | mysql = 需要 docker compose --profile mysql up -d mysql
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-me-to-a-long-random-string

# ---------- 模型 ----------
# mock = 规则抽取 + 模板问答，不联网、不要 key
# openai-compatible = 任意 OpenAI 兼容端点（DeepSeek / OpenAI / 通义 / Ollama）
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- 中间件 ----------
# caffeine | redis
CACHE_MODE=caffeine
# local | rocketmq（rocketmq 适配器尚未实现）
MQ_MODE=local

# ---------- MySQL（SPRING_PROFILES_ACTIVE=mysql 时生效）----------
DB_NAME=course_planner
DB_USER=planner
DB_PASSWORD=planner
MYSQL_ROOT_PASSWORD=root
# 本机 3306 常被占用，容器映射到 3307
MYSQL_HOST_PORT=3307

# ---------- 镜像（Docker Hub 不可达时改这里）----------
# MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9-eclipse-temurin-17
# JRE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
